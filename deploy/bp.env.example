# All optional. With none of this set the PWA still works; it simply has no
# camera OCR, no backup and no reminders.

# Gemini key for camera OCR. Server-side by design: a browser cannot hold it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OCR_DAILY_LIMIT=50

# Required for the admin API (invites, devices). A long random secret that
# the private proxy listener sends as X-Admin-Token. Unset = admin disabled.
ADMIN_TOKEN=

# Used to render invite links
PUBLIC_BASE_URL=https://example.com
# Contact address in VAPID push claims (RFC 8292)
VAPID_SUBJECT=mailto:you@example.com
